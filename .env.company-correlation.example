# ============================================================
# MCAAS-DES - Empresa + Empleados correlacionados
# ============================================================
# Mantenga sus credenciales reales fuera de Git.

APP_NAME=MCAAS - DES

# Primero se sincroniza nucleo_empresa; despues rh_empleado.
EXTRACTION_COUNT=2

# Los scripts ya devuelven sus columnas de negocio.
# extraction-empleado-edulag.sql devuelve source_name por si mismo,
# por eso MCAAS NO debe inyectar una segunda columna source_name.
INCLUDE_SOURCE_NAME=false
ORIGIN_FIELD_NAME=source_name

# Debe quedar vacio porque la extraccion de Empresa suministra nucleo_empresa.id
# usando GUIDEmpresa. La extraccion de Empleados no devuelve id, por lo que
# MySQL genera rh_empleado.id AUTO_INCREMENT normalmente.
DESTINATION_AUTO_ID_COLUMN=

# ------------------- 1. EMPRESA -----------------------------
EXTRACT_1_NAME=Empresa_CONTPAQi
EXTRACT_1_SCRIPT=./scripts/extraction-empresa-contpaqi.sql
EXTRACT_1_TARGET_TABLE=nucleo_empresa
EXTRACT_1_SYNC_KEY_COLUMNS=id
EXTRACT_1_DB_TYPE=mssql
EXTRACT_1_DB_URL=
EXTRACT_1_DB_HOST=127.0.0.1
EXTRACT_1_DB_PORT=1433
EXTRACT_1_DB_NAME=ctNOM_Edulag_2021
EXTRACT_1_DB_USER=usuario_lectura
EXTRACT_1_DB_PASSWORD=CAMBIAR_CONTRASENA
EXTRACT_1_DB_SSL=false
EXTRACT_1_DB_SSL_REJECT_UNAUTHORIZED=true
EXTRACT_1_DB_SSL_CA_PATH=
EXTRACT_1_DB_ENCRYPT=false
EXTRACT_1_DB_TRUST_SERVER_CERTIFICATE=true
EXTRACT_1_DB_CONNECTION_TIMEOUT_MS=15000
EXTRACT_1_DB_QUERY_TIMEOUT_MS=60000

# ------------------- 2. EMPLEADOS ---------------------------
EXTRACT_2_NAME=Empleado_EDULAG
EXTRACT_2_SCRIPT=./scripts/extraction-empleado-edulag.sql
EXTRACT_2_TARGET_TABLE=rh_empleado
# Se conserva la identidad actual para que los empleados existentes se actualicen
# y reciban empresa_id sin generar duplicados durante la transicion.
EXTRACT_2_SYNC_KEY_COLUMNS=source_name,numero_empleado
EXTRACT_2_DB_TYPE=mssql
EXTRACT_2_DB_URL=
EXTRACT_2_DB_HOST=127.0.0.1
EXTRACT_2_DB_PORT=1433
EXTRACT_2_DB_NAME=ctNOM_Edulag_2021
EXTRACT_2_DB_USER=usuario_lectura
EXTRACT_2_DB_PASSWORD=CAMBIAR_CONTRASENA
EXTRACT_2_DB_SSL=false
EXTRACT_2_DB_SSL_REJECT_UNAUTHORIZED=true
EXTRACT_2_DB_SSL_CA_PATH=
EXTRACT_2_DB_ENCRYPT=false
EXTRACT_2_DB_TRUST_SERVER_CERTIFICATE=true
EXTRACT_2_DB_CONNECTION_TIMEOUT_MS=15000
EXTRACT_2_DB_QUERY_TIMEOUT_MS=60000

# ------------------- CICLO ----------------------------------
POLL_INTERVAL_MS=2000
INTER_TARGET_DELAY_MS=300
BATCH_SIZE=250
HEARTBEAT_SECONDS=300

# ------------------- DESTINO AIVEN --------------------------
DESTINATION_COUNT=1
DEST_1_NAME=ERP_Dev
DEST_1_DB_TYPE=mysql
DEST_1_DB_URL=mysql://usuario:CAMBIAR_CONTRASENA@HOST_AIVEN:PUERTO/edulag_erp_dev
DEST_1_DB_HOST=
DEST_1_DB_PORT=
DEST_1_DB_NAME=
DEST_1_DB_USER=
DEST_1_DB_PASSWORD=
DEST_1_DB_SSL=true
DEST_1_DB_SSL_REJECT_UNAUTHORIZED=true
DEST_1_DB_SSL_CA_PATH=./certs/aiven-ca.pem
DEST_1_DB_ENCRYPT=false
DEST_1_DB_TRUST_SERVER_CERTIFICATE=false
DEST_1_DB_CONNECTION_TIMEOUT_MS=30000
DEST_1_DB_QUERY_TIMEOUT_MS=60000
DEST_1_HISTORICO=false

# IMPORTANTE: vacio. Cada script decide su tabla con MCAAS_TARGET_TABLE.
# Si se deja nucleo_empresa aqui, tambien intentaria enviar empleados a esa tabla.
DEST_1_TARGET_TABLE=

STATE_DIR=./state
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
DATA_FLAG_PER_ROW=true

FAILURE_THRESHOLD=5
FAILURE_WINDOW_HOURS=1
AUTO_RESTART_DELAY_MS=5000
PERSISTENT_PAUSE_CHECK_MS=10000

GMAIL_ENABLED=false
