# ============================================================
# MCAAS-DES - Empresa + Empleados multiempresa correlacionados
# ============================================================
# EJEMPLO SIN SECRETOS.
# NO reemplace su .env real completo por este archivo.
# Conserve las credenciales reales que ya funcionan y agregue/ajuste
# solamente los bloques EXTRACT_N que necesite.
#
# Empresas ya identificadas en nucleo_empresa:
#   EDULAG
#     C51D9348-5DA4-445C-AB90-66890241BA5E
#   TEQUILERA CASA ALAMOS
#     D1EEE7F0-ED97-4339-ABF3-BAC4BC260F18
#   PENTAGONO AGRICOLA
#     E0DA7FED-2B95-41F1-B81D-54260A680800
# ============================================================

APP_NAME=MCAAS - DES

# Este ejemplo conserva la extraccion actual de Empresa y agrega
# tres extracciones de Empleados: EDULAG, Tequilera y Pentagono.
EXTRACTION_COUNT=4

# Los scripts de empleados ya devuelven source_name por si mismos.
# MCAAS NO debe inyectar una segunda columna source_name.
INCLUDE_SOURCE_NAME=false
ORIGIN_FIELD_NAME=source_name

# Debe quedar vacio porque:
# - extraction-empresa-contpaqi.sql suministra nucleo_empresa.id (GUIDEmpresa)
# - los scripts de empleados NO envian rh_empleado.id, que sigue siendo AUTO_INCREMENT.
DESTINATION_AUTO_ID_COLUMN=

# ------------------- 1. EMPRESA ACTUAL ----------------------
# Se conserva el bloque que ya exista en su instalacion.
# Si sus tres empresas ya estan cargadas en nucleo_empresa, NO necesita
# crear nuevas filas manualmente antes de sincronizar empleados.
EXTRACT_1_NAME=Empresa_CONTPAQi
EXTRACT_1_SCRIPT=./scripts/extraction-empresa-contpaqi.sql
EXTRACT_1_TARGET_TABLE=nucleo_empresa
EXTRACT_1_SYNC_KEY_COLUMNS=id
EXTRACT_1_DB_TYPE=mssql
EXTRACT_1_DB_URL=
EXTRACT_1_DB_HOST=127.0.0.1
EXTRACT_1_DB_PORT=1433
EXTRACT_1_DB_NAME=ctNOM_Edulag_2021
EXTRACT_1_DB_USER=usuario_lectura
EXTRACT_1_DB_PASSWORD=CAMBIAR_CONTRASENA
EXTRACT_1_DB_SSL=false
EXTRACT_1_DB_SSL_REJECT_UNAUTHORIZED=true
EXTRACT_1_DB_SSL_CA_PATH=
EXTRACT_1_DB_ENCRYPT=false
EXTRACT_1_DB_TRUST_SERVER_CERTIFICATE=true
EXTRACT_1_DB_CONNECTION_TIMEOUT_MS=15000
EXTRACT_1_DB_QUERY_TIMEOUT_MS=60000

# ------------------- 2. EMPLEADOS EDULAG --------------------
EXTRACT_2_NAME=Empleado_EDULAG
EXTRACT_2_SCRIPT=./scripts/extraction-empleado-edulag.sql
EXTRACT_2_TARGET_TABLE=rh_empleado
EXTRACT_2_SYNC_KEY_COLUMNS=source_name,numero_empleado
EXTRACT_2_DB_TYPE=mssql
EXTRACT_2_DB_URL=
EXTRACT_2_DB_HOST=127.0.0.1
EXTRACT_2_DB_PORT=1433
EXTRACT_2_DB_NAME=ctNOM_Edulag_2021
EXTRACT_2_DB_USER=usuario_lectura
EXTRACT_2_DB_PASSWORD=CAMBIAR_CONTRASENA
EXTRACT_2_DB_SSL=false
EXTRACT_2_DB_SSL_REJECT_UNAUTHORIZED=true
EXTRACT_2_DB_SSL_CA_PATH=
EXTRACT_2_DB_ENCRYPT=false
EXTRACT_2_DB_TRUST_SERVER_CERTIFICATE=true
EXTRACT_2_DB_CONNECTION_TIMEOUT_MS=15000
EXTRACT_2_DB_QUERY_TIMEOUT_MS=60000

# ------------------- 3. EMPLEADOS TEQUILERA -----------------
# source_name devuelto por el SQL: TEQUILERA_CASA_ALAMOS
# GUID esperado: D1EEE7F0-ED97-4339-ABF3-BAC4BC260F18
EXTRACT_3_NAME=Empleado_TEQUILERA_CASA_ALAMOS
EXTRACT_3_SCRIPT=./scripts/extraction-empleado-tequilera.sql
EXTRACT_3_TARGET_TABLE=rh_empleado
EXTRACT_3_SYNC_KEY_COLUMNS=source_name,numero_empleado
EXTRACT_3_DB_TYPE=mssql
EXTRACT_3_DB_URL=
EXTRACT_3_DB_HOST=127.0.0.1
EXTRACT_3_DB_PORT=1433
EXTRACT_3_DB_NAME=ctNOM_TEQUILERA_CASA
EXTRACT_3_DB_USER=usuario_lectura
EXTRACT_3_DB_PASSWORD=CAMBIAR_CONTRASENA
EXTRACT_3_DB_SSL=false
EXTRACT_3_DB_SSL_REJECT_UNAUTHORIZED=true
EXTRACT_3_DB_SSL_CA_PATH=
EXTRACT_3_DB_ENCRYPT=false
EXTRACT_3_DB_TRUST_SERVER_CERTIFICATE=true
EXTRACT_3_DB_CONNECTION_TIMEOUT_MS=15000
EXTRACT_3_DB_QUERY_TIMEOUT_MS=60000

# ------------------- 4. EMPLEADOS PENTAGONO -----------------
# source_name devuelto por el SQL: PENTAGONO_AGRICOLA
# GUID esperado: E0DA7FED-2B95-41F1-B81D-54260A680800
EXTRACT_4_NAME=Empleado_PENTAGONO_AGRICOLA
EXTRACT_4_SCRIPT=./scripts/extraction-empleado-pentagono.sql
EXTRACT_4_TARGET_TABLE=rh_empleado
EXTRACT_4_SYNC_KEY_COLUMNS=source_name,numero_empleado
EXTRACT_4_DB_TYPE=mssql
EXTRACT_4_DB_URL=
EXTRACT_4_DB_HOST=127.0.0.1
EXTRACT_4_DB_PORT=1433
EXTRACT_4_DB_NAME=ctPentagono_Agric
EXTRACT_4_DB_USER=usuario_lectura
EXTRACT_4_DB_PASSWORD=CAMBIAR_CONTRASENA
EXTRACT_4_DB_SSL=false
EXTRACT_4_DB_SSL_REJECT_UNAUTHORIZED=true
EXTRACT_4_DB_SSL_CA_PATH=
EXTRACT_4_DB_ENCRYPT=false
EXTRACT_4_DB_TRUST_SERVER_CERTIFICATE=true
EXTRACT_4_DB_CONNECTION_TIMEOUT_MS=15000
EXTRACT_4_DB_QUERY_TIMEOUT_MS=60000

# ------------------- CICLO ----------------------------------
POLL_INTERVAL_MS=2000
INTER_TARGET_DELAY_MS=300
BATCH_SIZE=250
HEARTBEAT_SECONDS=300

# ------------------- DESTINO AIVEN --------------------------
DESTINATION_COUNT=1
DEST_1_NAME=ERP_Dev
DEST_1_DB_TYPE=mysql
DEST_1_DB_URL=mysql://usuario:CAMBIAR_CONTRASENA@HOST_AIVEN:PUERTO/edulag_erp_dev
DEST_1_DB_HOST=
DEST_1_DB_PORT=
DEST_1_DB_NAME=
DEST_1_DB_USER=
DEST_1_DB_PASSWORD=
DEST_1_DB_SSL=true
DEST_1_DB_SSL_REJECT_UNAUTHORIZED=true
DEST_1_DB_SSL_CA_PATH=./certs/aiven-ca.pem
DEST_1_DB_ENCRYPT=false
DEST_1_DB_TRUST_SERVER_CERTIFICATE=false
DEST_1_DB_CONNECTION_TIMEOUT_MS=30000
DEST_1_DB_QUERY_TIMEOUT_MS=60000
DEST_1_HISTORICO=false

# IMPORTANTE: debe quedar vacio.
# Cada script decide su propia tabla mediante MCAAS_TARGET_TABLE.
DEST_1_TARGET_TABLE=

STATE_DIR=./state
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
DATA_FLAG_PER_ROW=true

FAILURE_THRESHOLD=5
FAILURE_WINDOW_HOURS=1
AUTO_RESTART_DELAY_MS=5000
PERSISTENT_PAUSE_CHECK_MS=10000

GMAIL_ENABLED=false
