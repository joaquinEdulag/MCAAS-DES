# ============================================================
# MCAAS - DES v1.1
# Middle - Connector as a Service - Database Extractor n Sender
# Copie este archivo como .env y reemplace todos los valores.
# NO suba su .env real al repositorio.
# ============================================================

APP_NAME=MCAAS - DES

# ------------------ EXTRACCIONES / ORIGENES -----------------
# Cada EXTRACT_N representa UNA consulta SQL contra UNA BD origen.
# Puede tener varias consultas sobre la misma BD o consultas sobre BDs distintas.
# EXTRACT_N_NAME debe ser único y estable: se guardará en cada fila destino.
EXTRACTION_COUNT=2

# Campo adicional que MCAAS agregará automáticamente a TODAS las filas destino.
# Su valor será EXTRACT_N_NAME.
ORIGIN_FIELD_NAME=source_name

# PK autoincremental administrada exclusivamente por la BD destino.
# MCAAS NO la inserta ni la actualiza. Si el SELECT origen devuelve una columna
# con este nombre, MCAAS detendrá esa extracción y pedirá usar un alias.
# Ejemplo correcto: SELECT id AS empleado_id, nombre FROM empleados;
DESTINATION_AUTO_ID_COLUMN=id

# Extracción 1 - ejemplo: empleados de una empresa/sucursal
EXTRACT_1_NAME=Empleados_Matriz
EXTRACT_1_SCRIPT=./scripts/extraction-empleados.sql
# Fallbacks opcionales si el SQL no trae MCAAS_TARGET_TABLE / MCAAS_KEY_COLUMNS:
EXTRACT_1_TARGET_TABLE=
EXTRACT_1_SYNC_KEY_COLUMNS=
# Valores soportados: mssql | postgres | mysql
EXTRACT_1_DB_TYPE=mssql
# Alternativa: EXTRACT_1_DB_URL y omitir HOST/PORT/NAME/USER/PASSWORD.
EXTRACT_1_DB_URL=
EXTRACT_1_DB_HOST=127.0.0.1
EXTRACT_1_DB_PORT=1433
EXTRACT_1_DB_NAME=CONTPAQ_MATRIZ
EXTRACT_1_DB_USER=usuario_lectura
EXTRACT_1_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
EXTRACT_1_DB_SSL=false
EXTRACT_1_DB_SSL_REJECT_UNAUTHORIZED=true
EXTRACT_1_DB_SSL_CA_PATH=
EXTRACT_1_DB_ENCRYPT=false
EXTRACT_1_DB_TRUST_SERVER_CERTIFICATE=true
EXTRACT_1_DB_CONNECTION_TIMEOUT_MS=15000
EXTRACT_1_DB_QUERY_TIMEOUT_MS=60000

# Extracción 2 - puede ser otra tabla de la misma BD o una BD totalmente distinta.
EXTRACT_2_NAME=Empleados_Sucursal_Norte
EXTRACT_2_SCRIPT=./scripts/extraction-empleados-sucursal.sql
EXTRACT_2_TARGET_TABLE=
EXTRACT_2_SYNC_KEY_COLUMNS=
EXTRACT_2_DB_TYPE=mssql
EXTRACT_2_DB_URL=
EXTRACT_2_DB_HOST=10.0.0.25
EXTRACT_2_DB_PORT=1433
EXTRACT_2_DB_NAME=CONTPAQ_NORTE
EXTRACT_2_DB_USER=usuario_lectura
EXTRACT_2_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
EXTRACT_2_DB_SSL=false
EXTRACT_2_DB_SSL_REJECT_UNAUTHORIZED=true
EXTRACT_2_DB_SSL_CA_PATH=
EXTRACT_2_DB_ENCRYPT=false
EXTRACT_2_DB_TRUST_SERVER_CERTIFICATE=true
EXTRACT_2_DB_CONNECTION_TIMEOUT_MS=15000
EXTRACT_2_DB_QUERY_TIMEOUT_MS=60000

# Para EXTRACT_3, EXTRACT_4, ... repita el mismo patrón EXTRACT_N_*.
# No es necesario recompilar MCAAS al agregar/quitar extracciones: basta modificar .env
# y agregar el SQL correspondiente, después reiniciar el servicio.

# Compatibilidad con v1.0.x:
# Si EXTRACTION_COUNT NO está definido, MCAAS todavía acepta SOURCE_DB_* +
# EXTRACTION_SCRIPT + TARGET_TABLE + SYNC_KEY_COLUMNS como una sola extracción.

# ------------------ CICLO DE SINCRONIZACION -----------------
# Frecuencia entre ciclos completos. Cada ciclo recorre TODAS las extracciones.
POLL_INTERVAL_MS=2000
# Pausa entre intento de un destino y el siguiente, sea exitoso o fallido.
INTER_TARGET_DELAY_MS=300
# Cantidad máxima de filas por transacción de destino.
BATCH_SIZE=250
# Cada cuántos segundos se escribe heartbeat cuando no hay cambios.
HEARTBEAT_SECONDS=300

# ---------------------- DESTINOS ----------------------------
# Todos los datos de todas las extracciones se intentan enviar a todos los destinos.
# Entre 1 y 10.
DESTINATION_COUNT=1

# Destino 1 - ejemplo Aiven PostgreSQL / Producción
DEST_1_NAME=Produccion
DEST_1_DB_TYPE=postgres
DEST_1_DB_URL=
DEST_1_DB_HOST=example-project.aivencloud.com
DEST_1_DB_PORT=12345
DEST_1_DB_NAME=defaultdb
DEST_1_DB_USER=avnadmin
DEST_1_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DEST_1_DB_SSL=true
DEST_1_DB_SSL_REJECT_UNAUTHORIZED=false
DEST_1_DB_SSL_CA_PATH=
DEST_1_DB_ENCRYPT=true
DEST_1_DB_TRUST_SERVER_CERTIFICATE=false
DEST_1_DB_CONNECTION_TIMEOUT_MS=15000
DEST_1_DB_QUERY_TIMEOUT_MS=60000
DEST_1_HISTORICO=false
# Opcional: fuerza TODAS las extracciones de este destino a una misma tabla.
# Si está vacío, cada script usa su MCAAS_TARGET_TABLE.
DEST_1_TARGET_TABLE=

# Destino 2 - se ignora mientras DESTINATION_COUNT sea menor a 2.
DEST_2_NAME=Shadow
DEST_2_DB_TYPE=postgres
DEST_2_DB_URL=
DEST_2_DB_HOST=127.0.0.1
DEST_2_DB_PORT=5432
DEST_2_DB_NAME=shadow_db
DEST_2_DB_USER=shadow_user
DEST_2_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DEST_2_DB_SSL=false
DEST_2_DB_SSL_REJECT_UNAUTHORIZED=true
DEST_2_DB_SSL_CA_PATH=
DEST_2_DB_ENCRYPT=false
DEST_2_DB_TRUST_SERVER_CERTIFICATE=true
DEST_2_DB_CONNECTION_TIMEOUT_MS=15000
DEST_2_DB_QUERY_TIMEOUT_MS=60000
DEST_2_HISTORICO=true
DEST_2_TARGET_TABLE=

# Para DEST_3 ... DEST_10, repita exactamente el mismo patrón DEST_N_*.

# -------------------- ESTADO Y LOGS -------------------------
# Rutas relativas al directorio donde está el .env.
STATE_DIR=./state
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
# true = registra una bandera/hash por cambio, nunca los datos reales de la fila.
DATA_FLAG_PER_ROW=true

# ---------------- POLITICA DE RECUPERACION ------------------
# Si se acumulan FAILURE_THRESHOLD fallos dentro de FAILURE_WINDOW_HOURS,
# el sistema entra a "Error persistente en curso" y pausa extracción/envío.
FAILURE_THRESHOLD=5
FAILURE_WINDOW_HOURS=1
AUTO_RESTART_DELAY_MS=5000
PERSISTENT_PAUSE_CHECK_MS=10000

# ----------------------- GMAIL API --------------------------
# OAuth 2.0 con scope: https://www.googleapis.com/auth/gmail.send
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://localhost:53682/oauth2callback
GMAIL_FROM=alertas@tu-dominio.com
GMAIL_ALERT_TO=soporte@tu-dominio.com
