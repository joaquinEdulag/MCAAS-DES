# ============================================================
# MCAAS - DES
# Middle - Connector as a Service - Database Extractor n Sender
# Copie este archivo como .env y reemplace todos los valores.
# NO suba su .env real al repositorio.
# ============================================================

APP_NAME=MCAAS - DES

# -------------------- BASE DE DATOS ORIGEN ------------------
# Valores soportados: mssql | postgres | mysql
SOURCE_DB_TYPE=mssql
# Alternativa: puede usar SOURCE_DB_URL y omitir HOST/PORT/NAME/USER/PASSWORD.
SOURCE_DB_URL=
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=1433
SOURCE_DB_NAME=MiBaseOrigen
SOURCE_DB_USER=usuario_lectura
SOURCE_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
SOURCE_DB_SSL=false
SOURCE_DB_SSL_REJECT_UNAUTHORIZED=true
SOURCE_DB_SSL_CA_PATH=
# Opciones específicas/relevantes para SQL Server:
SOURCE_DB_ENCRYPT=false
SOURCE_DB_TRUST_SERVER_CERTIFICATE=true
SOURCE_DB_CONNECTION_TIMEOUT_MS=15000
SOURCE_DB_QUERY_TIMEOUT_MS=60000

# ---------------------- EXTRACCION --------------------------
# Ruta relativa al .env o absoluta.
EXTRACTION_SCRIPT=./scripts/extraction.sql
# Fallbacks si el script no incluye sus metadatos MCAAS:
TARGET_TABLE=
SYNC_KEY_COLUMNS=
# Frecuencia de lectura. 2000 ms = aproximadamente 2 s entre ciclos.
POLL_INTERVAL_MS=2000
# Pausa obligatoria entre intento de un destino y el siguiente.
INTER_TARGET_DELAY_MS=300
# Cantidad máxima de filas por transacción de destino.
BATCH_SIZE=100
# Cada cuántos segundos se escribe un heartbeat cuando no hay cambios.
HEARTBEAT_SECONDS=300

# ---------------------- DESTINOS ----------------------------
# Entre 1 y 10.
DESTINATION_COUNT=1

# Destino 1 - ejemplo Aiven PostgreSQL / Producción
DEST_1_NAME=Produccion
DEST_1_DB_TYPE=postgres
DEST_1_DB_URL=
DEST_1_DB_HOST=example-project.aivencloud.com
DEST_1_DB_PORT=12345
DEST_1_DB_NAME=defaultdb
DEST_1_DB_USER=avnadmin
DEST_1_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DEST_1_DB_SSL=true
DEST_1_DB_SSL_REJECT_UNAUTHORIZED=false
DEST_1_DB_SSL_CA_PATH=
DEST_1_DB_ENCRYPT=true
DEST_1_DB_TRUST_SERVER_CERTIFICATE=false
DEST_1_DB_CONNECTION_TIMEOUT_MS=15000
DEST_1_DB_QUERY_TIMEOUT_MS=60000
DEST_1_HISTORICO=false
# Opcional: sobrescribe MCAAS_TARGET_TABLE solo para este destino.
DEST_1_TARGET_TABLE=

# Destino 2 - se ignora mientras DESTINATION_COUNT sea menor a 2.
DEST_2_NAME=Shadow
DEST_2_DB_TYPE=postgres
DEST_2_DB_URL=
DEST_2_DB_HOST=127.0.0.1
DEST_2_DB_PORT=5432
DEST_2_DB_NAME=shadow_db
DEST_2_DB_USER=shadow_user
DEST_2_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DEST_2_DB_SSL=false
DEST_2_DB_SSL_REJECT_UNAUTHORIZED=true
DEST_2_DB_SSL_CA_PATH=
DEST_2_DB_ENCRYPT=false
DEST_2_DB_TRUST_SERVER_CERTIFICATE=true
DEST_2_DB_CONNECTION_TIMEOUT_MS=15000
DEST_2_DB_QUERY_TIMEOUT_MS=60000
DEST_2_HISTORICO=true
DEST_2_TARGET_TABLE=

# Destino 3 - se ignora mientras DESTINATION_COUNT sea menor a 3.
DEST_3_NAME=Dev
DEST_3_DB_TYPE=mysql
DEST_3_DB_URL=
DEST_3_DB_HOST=127.0.0.1
DEST_3_DB_PORT=3306
DEST_3_DB_NAME=dev_db
DEST_3_DB_USER=dev_user
DEST_3_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DEST_3_DB_SSL=false
DEST_3_DB_SSL_REJECT_UNAUTHORIZED=true
DEST_3_DB_SSL_CA_PATH=
DEST_3_DB_ENCRYPT=false
DEST_3_DB_TRUST_SERVER_CERTIFICATE=true
DEST_3_DB_CONNECTION_TIMEOUT_MS=15000
DEST_3_DB_QUERY_TIMEOUT_MS=60000
DEST_3_HISTORICO=false
DEST_3_TARGET_TABLE=

# Para DEST_4 ... DEST_10, repita exactamente el mismo patrón DEST_N_*.

# -------------------- ESTADO Y LOGS -------------------------
# Rutas relativas al directorio donde está el .env.
STATE_DIR=./state
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
# true = registra una bandera/hash por cambio, pero nunca los datos de la fila.
DATA_FLAG_PER_ROW=true

# ---------------- POLITICA DE RECUPERACION ------------------
# Si se acumulan FAILURE_THRESHOLD fallos dentro de FAILURE_WINDOW_HOURS,
# el sistema entra a "Error persistente en curso" y pausa extracción/envío.
FAILURE_THRESHOLD=5
FAILURE_WINDOW_HOURS=1
AUTO_RESTART_DELAY_MS=5000
PERSISTENT_PAUSE_CHECK_MS=10000

# ----------------------- GMAIL API --------------------------
# OAuth 2.0 con scope: https://www.googleapis.com/auth/gmail.send
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://localhost:53682/oauth2callback
GMAIL_FROM=alertas@tu-dominio.com
GMAIL_ALERT_TO=soporte@tu-dominio.com
